# Nutri Environment Configuration

# =========================================================
# Option 1: GMI Cloud Model Hub (OpenAI-compatible)
# =========================================================
# GMI_API_KEY=your_gmi_cloud_api_key_here
# GMI_BASE_URL=https://api.gmicloud.ai/v1
# GMI_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
# (Other popular GMI models: Qwen/Qwen2.5-72B-Instruct, mistralai/Mistral-7B-Instruct-v0.3)

# =========================================================
# Option 2: Google Gemini API
# =========================================================
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# =========================================================
# Option 3: Standard OpenAI or Custom Endpoint
# =========================================================
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# =========================================================
# DataHub GMS Endpoint Configuration
# =========================================================
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GRAPHQL_URL=http://localhost:8080/api/graphql
